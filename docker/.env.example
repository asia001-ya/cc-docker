# tdc docker compose 配置示例：复制为 .env 后按需修改
# 宿主机项目源码目录（建议放在 WSL2 文件系统，如 \wsl$\Ubuntu\home\me\app，Windows 盘符路径 I/O 较慢）
PROJECT_DIR=./workspace
# 容器内项目目录名：所有容器挂到相同路径 /workspace/<PROJECT_NAME>，保证热切换后 cwd 一致
PROJECT_NAME=app
# 镜像中锁定的 Claude Code 版本
CLAUDE_CODE_VERSION=2.1.300
TDC_IMAGE_TAG=latest
TDC_CPUS=4
TDC_MEMORY=8g
TZ=Asia/Shanghai
# 宿主端口覆盖（默认规则：容器端口 + 10 × 槽位号）
# DEV01_PORT_3000=3010
# DEV02_PORT_3000=3020
